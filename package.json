{
  "name": "skatelegend",
  "version": "1.0.0",
  "description": "",
  "main": "modules/js/Game.js",
  "scripts": {
    "build:ts": "rollup -c",
    "build:scss": "sass --no-source-map src/skatelegend.scss skatelegend.css",
    "watch:ts": "rollup -c -w",
    "watch:scss": "sass --watch --no-source-map src/skatelegend.scss:skatelegend.css",
    "build": "npm run build:ts && npm run build:scss",
    "watch": "npm run watch:ts & npm run watch:scss",
    "typecheck": "node build/legacy-libs.mjs && tsc --noEmit"
  },
  "author": "",
