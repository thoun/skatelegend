  "dependencies": {
    "bga-animations": "thoun/bga-animations#1.0.2",
    "bga-cards": "thoun/bga-cards#2.0.2",
    "bga-help": "thoun/bga-help#1.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "rollup": "^4.68.5",
    "sass": "^1.62.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3"
  }
}
